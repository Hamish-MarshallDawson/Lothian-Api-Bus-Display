# Settings for busTrack. Copy to ~/.config/bustracker/env (or the systemd
# EnvironmentFile) and fill in. Never commit the real file.
#
# Load for a shell:  set -a; . ~/.config/bustracker/env; set +a

# Novus Open API subscription key (Edinburgh Trapeze developer portal).
BUSTRACKER_KEY=

# Home address, used to find the nearest stops. Required.
BUS_ADDRESS=

# How many stops to offer in each direction group. Optional, default 8.
BUS_NUM_STOPS=8

# Sent as the HTTP User-Agent. Optional. Don't put personal details here.
BUS_USER_AGENT=LothianBusDisplay/1.0
