# Settings for busTrack. Copy to ~/.config/bustracker/env (or the systemd
# EnvironmentFile) and fill in. Never commit the real file. Keep it mode 600.
#
# Load for a shell:  set -a; . ~/.config/bustracker/env; set +a

# Novus Open API subscription key (Edinburgh Trapeze developer portal).
BUSTRACKER_KEY=

# Home position, decimal degrees. Set both and the home address is never sent
# anywhere: no geocoder call at all. Find them once (e.g. from the geocoder result
# for your address) and paste them here.
BUS_HOME_LAT=
BUS_HOME_LON=

# Home address: an optional fallback, used only when BUS_HOME_LAT/LON are not set.
# It is geocoded once, cached forever on disk (hashed), at most one request a second,
# and nothing is sent for an hour after a failure. It is personal data.
BUS_ADDRESS=

# Geocoder endpoint, used only with BUS_ADDRESS. Default: Nominatim.
BUS_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Map tiles, with {z} {x} {y}. Default: the OpenStreetMap tile server (usage policy:
# operations.osmfoundation.org/policies/tiles). Change it here, no rebuild needed.
BUS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# How many stops to offer in each direction group. Optional, default 8.
BUS_NUM_STOPS=8

# Sent as the HTTP User-Agent on every request. Optional. The default names the app
# and where to find it, as the usage policies ask. Leave it unless you have a reason.
BUS_USER_AGENT=LothianBusDisplay/1.0 (+https://github.com/Hamish-MarshallDawson/Lothian-Api-Bus-Display)
